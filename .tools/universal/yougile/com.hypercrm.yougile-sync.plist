<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd-агент: сам заливает очередь queue.jsonl в YouGile.
  Срабатывает при изменении очереди + раз в 5 минут страховкой.

  Установка (один раз, в Терминале):
    1) впиши ниже свой YOUGILE_API_KEY и YOUGILE_BOARD_ID (узнать: python3 yougile.py boards)
    2) cp com.hypercrm.yougile-sync.plist ~/Library/LaunchAgents/
    3) launchctl load ~/Library/LaunchAgents/com.hypercrm.yougile-sync.plist
  Снять:  launchctl unload ~/Library/LaunchAgents/com.hypercrm.yougile-sync.plist
  Лог:    pushed.log в папке скрипта
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hypercrm.yougile-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/vladimirtarasov/Yandex.Disk.localized/HyperCRM/.tools/universal/yougile/sync.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vladimirtarasov/Yandex.Disk.localized/HyperCRM/.tools/universal/yougile</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>YOUGILE_API_KEY</key>
        <string>ВСТАВЬ_КЛЮЧ</string>
        <key>YOUGILE_BOARD_ID</key>
        <string>ВСТАВЬ_ID_ДОСКИ</string>
    </dict>

    <key>WatchPaths</key>
    <array>
        <string>/Users/vladimirtarasov/Yandex.Disk.localized/HyperCRM/.tools/universal/yougile/queue.jsonl</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/vladimirtarasov/Yandex.Disk.localized/HyperCRM/.tools/universal/yougile/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vladimirtarasov/Yandex.Disk.localized/HyperCRM/.tools/universal/yougile/launchd.err.log</string>
</dict>
</plist>
