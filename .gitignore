# Secrets & credentials — никогда не коммитим
system/secrets/
**/access.md
*.key
*.pem
.env
.env.local
.mcp.json

# OS / IDE
.DS_Store
*.swp
.vscode/
.idea/

# Claude local overrides (содержит разрешения на конкретной машине)
.claude/settings.local.json

# Obsidian UI state is device-specific and causes sync conflicts
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Окружения и зависимости — пересобираются, не версионируются
.tools/venv/
.tools/venv-whisper/
.tools/.pip-cache/
node_modules/
.pnpm-store/
__pycache__/
*.pyc

# Временное
tmp/

# Состояние прогонов разбора — вне волта, не версионируется
.tools/review-state.json
.tools/board.html

# Local analytics databases are generated on each device and exceed GitHub limits
**/data/*.sqlite3
**/data/*.sqlite

# Данные, а не выводы: сырьё и генерируемое остаётся на диске, но не версионируется
# (правило «контракт данных» в CLAUDE.md)
**/inbox/**/*.csv
**/inbox/**/*.xlsx
**/dashboard/data.js
**/*_source.csv
**/*_source.xls
**/*_source.xlsx
**/*_leads.csv
# Скриншоты пересоздаёт snapshot.py. Снимок, оставляемый как датированное
# доказательство, добавляется явно: git add -f; уже закреплённые остаются в git
.tools/snapshots/*
# Рабочие данные и диагностические отчёты контента карт; конечные клиентские
# материалы и выбранные фото остаются в clients/*/reports/.
.tools/projects/geo-content/20*/
.tools/projects/arcars/geo-content/20*/
# Картинки Unisec для Яндекс Карт собирает build-images-from-sources.py из source/;
# v9 собрана вручную, исходника нет — остаётся в git
clients/unisec-novosibirsk/assets/yandex-maps-services/*
!clients/unisec-novosibirsk/assets/yandex-maps-services/source/
!clients/unisec-novosibirsk/assets/yandex-maps-services/khimchistka-pukhovika-novosibirsk-unisec-v9.jpg
