# Secrets & credentials — никогда не коммитим
system/secrets/
projects/**/access.md
*.key
*.pem
.env
.env.local
.mcp.json

# OS / IDE
.DS_Store
*.swp
.vscode/
.idea/

# Claude local overrides (содержит разрешения на конкретной машине)
.claude/settings.local.json

# Obsidian UI state is device-specific and causes sync conflicts
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Окружения и зависимости — пересобираются, не версионируются
.tools/venv/
node_modules/
.pnpm-store/
__pycache__/
*.pyc

# Временное
tmp/

# Состояние прогонов разбора — вне волта, не версионируется
.tools/review-state.json
.tools/board.html

# Local analytics databases are generated on each device and exceed GitHub limits
projects/**/data/*.sqlite3
projects/**/data/*.sqlite
