# Secrets & credentials — никогда не коммитим
system/secrets/
projects/**/access.md
*.key
*.pem
.env
.env.local
.mcp.json

# OS / IDE
.DS_Store
*.swp
.vscode/
.idea/

# Claude local overrides (содержит разрешения на конкретной машине)
.claude/settings.local.json

# Obsidian UI state is device-specific and causes sync conflicts
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Окружения и зависимости — пересобираются, не версионируются
.tools/venv/
node_modules/
.pnpm-store/
__pycache__/
*.pyc

# Временное
tmp/

# Состояние прогонов разбора — вне волта, не версионируется
.tools/review-state.json
.tools/board.html

# Local analytics databases are generated on each device and exceed GitHub limits
projects/**/data/*.sqlite3
projects/**/data/*.sqlite

# Данные, а не выводы: сырьё и генерируемое остаётся на диске, но не версионируется
# (правило «контракт данных» в CLAUDE.md)
projects/**/levsha-dashboard/dashboard/data.js
projects/**/levsha-dashboard/inbox/**/*.csv
projects/**/levsha-dashboard/inbox/**/*.xlsx
projects/**/levsha-dashboard/archive/
projects/**/wordstat-leads-correlation-*/**/*_source.csv
projects/**/wordstat-leads-correlation-*/**/*_source.xls
projects/**/wordstat-leads-correlation-*/**/*_source.xlsx
projects/**/wordstat-leads-correlation-*/**/*_leads.csv
projects/**/wordstat-leads-correlation-*/leads_source.csv
projects/**/wordstat-leads-correlation-*/wordstat_source.csv
projects/**/wordstat-leads-correlation-*/wordstat_source.xlsx
.tools/snapshots/lazyhim-*.png
.tools/snapshots/yt-lazyhim-*.png
